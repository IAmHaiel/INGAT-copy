# INGAT Vault — Environment Variables
# Copy this file to .env.local and fill in your deployed contract IDs.
# Run `npm run contract:deploy` to deploy contracts and get the values.

NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_TOKEN_ID=
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Supabase Integration (Client-Side)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Integration (Server-Side Challenge-Response)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI integration 
GROQ_API_KEY="your-groq-api-key"
