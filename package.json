{
  "name": "ingat-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=web",
    "lint": "npm run lint --workspace=web",
    "contract:build": "cargo build --manifest-path contracts/ingat-vault/Cargo.toml --target wasm32-unknown-unknown --release",
    "contract:test": "cargo test --manifest-path contracts/ingat-vault/Cargo.toml",
    "contract:clean": "cargo clean --manifest-path contracts/ingat-vault/Cargo.toml"
  }
}
